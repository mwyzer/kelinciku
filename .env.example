# Konfigurasi Lingkungan Terpadu PT Dua Kelinci

# Backend Config
BACKEND_PORT=8000
ENVIRONMENT=production
TZ=Asia/Jakarta

# Frontend Config
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_API_INTERNAL_URL=http://backend:8000/api/:path*

# Database (PostgreSQL)
POSTGRES_DB=duakelinci_dwh
POSTGRES_USER=duakelinci_user
POSTGRES_PASSWORD=ganti_dengan_password_kuat

# SMTP (Google App Password) - JANGAN commit nilai asli
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# CORS - origin frontend yang boleh memanggil API (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
